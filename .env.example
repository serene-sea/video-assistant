# 复制本文件为 backend/.env；密钥只放在本地 .env，不要提交到 Git。
# OpenAI 兼容的聊天模型配置。
CHAT_API_KEY=
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-chat
AGENT_MODEL=deepseek-flash
CHAT_TIMEOUT_SECONDS=120

# 视频字幕向量与聊天模型分开配置；可选独立远程服务或本地模型。
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
EMBEDDING_TIMEOUT_SECONDS=60
# 若使用本地 Qwen3，改选下面配置；模型路径相对 backend 目录解析。
# EMBEDDING_PROVIDER=sentence-transformers-local
# EMBEDDING_MODEL=Qwen3-Embedding-0.6B
# EMBEDDING_MODEL_PATH=./models/Qwen3-Embedding-0.6B
# EMBEDDING_DIMENSION=1024
# 默认自动选择可用 GPU；没有 CUDA 版 PyTorch 或可用 GPU 时自动用 CPU。
# EMBEDDING_DEVICE=auto
# EMBEDDING_QUERY_PROMPT=query
CHROMA_PATH=./data/chroma
# 初始 cosine distance 阈值；必须用所选模型的有答案/无答案校准集调整。
RAG_MAX_COSINE_DISTANCE=0.35
RAG_TOP_K=5
RAG_MAX_EVIDENCE_CHARS=6000

# 受限站点可选：Netscape 格式 Cookie 文件。相对路径按 backend 目录解析。
# Cookie 属于敏感信息，必须保持在 .gitignore 中。
YTDLP_COOKIE_FILE=

# 无平台字幕时使用 faster-whisper 识别人声。本机 RTX 4060 可先测试 CUDA FP16。
WHISPER_MODEL=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
MIN_TRANSCRIPT_CHARS=40

# 总结策略阈值：较短字幕直接总结，超过阈值后按块生成局部摘要再合并。
DIRECT_SUMMARY_CHAR_LIMIT=12000
SUMMARY_CHUNK_CHAR_LIMIT=6000

# SQLite 路径和本地前端地址。
DATABASE_PATH=./data/video_assistant.db
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
